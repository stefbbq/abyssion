{
  "lock": false,
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check **/*.ts && deno check **/*.tsx",
    "cli": "echo \"import '$fresh/src/dev/cli.ts'\" | deno run --unstable -A -",
    "manifest": "deno task cli manifest $(pwd)",
    "start": "deno run -A --watch=static/,routes/ dev.ts",
    "build": "deno run -A dev.ts build",
    "preview": "deno run -A main.ts",
    "update": "deno run -A -r https://fresh.deno.dev/update .",
    "build:shaders:preprocess": "deno run --allow-read --allow-write scripts/glsl-preprocessor.ts",
    "build:shaders:to-ts": "deno run --allow-read --allow-write scripts/glsl-to-ts.ts",
    "build:shaders": "deno task build:shaders:preprocess && deno task build:shaders:to-ts",
    "dev": "deno task build:shaders && deno run --allow-all dev.ts",
    "watch": "deno run --allow-read --allow-write --allow-run scripts/dev-watch.ts",
    "e2e": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts",
    "e2e:all": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts all",
    "e2e:quick": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts quick",
    "e2e:ci": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts ci",
    "e2e:core": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts category \"Core Functionality\"",
    "e2e:performance": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts category \"Performance & Memory\"",
    "e2e:errors": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts category \"Error Handling & Recovery\"",
    "e2e:network": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts category \"Network Conditions\"",
    "e2e:automated": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts automated",
    "e2e:live": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts live",
    "e2e:browser": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts browser",
    "e2e:priority": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts priority",
    "e2e:memory": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts tags memory-leaks",
    "e2e:anti-repetition": "deno run --allow-net --allow-run --allow-read --allow-write --allow-env scripts/run-e2e-tests.ts tags anti-repetition"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 140,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json"]
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@src/": "./",
    "@utils/": "./utils/",
    "@data/": "./data/",
    "@islands/": "./islands/",
    "@components/": "./components/",
    "@lib/": "./lib/",
    "@libgl/": "./lib/gl/",
    "@libtheme/": "./lib/theme/",
    "@liblogger/": "./lib/logger/",
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "phosphor-react": "npm:phosphor-react@^1.4.1",
    "preact": "https://esm.sh/preact@10.22.0",
    "preact/": "https://esm.sh/preact@10.22.0/",
    "puppeteer": "npm:puppeteer@^24.15.0",
    "react": "https://esm.sh/preact@10.22.0/compat",
    "react/jsx-runtime": "https://esm.sh/preact@10.22.0/jsx-runtime",
    "react-dom": "https://esm.sh/preact@10.22.0/compat",
    "@preact/signals": "https://esm.sh/*@preact/signals@1.2.2",
    "@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.5.1",
    "tailwindcss": "npm:tailwindcss@3.4.1",
    "tailwindcss/": "npm:/tailwindcss@3.4.1/",
    "tailwindcss/plugin": "npm:/tailwindcss@3.4.1/plugin.js",
    "$std/": "https://deno.land/std@0.216.0/",
    "three": "npm:three@0.149.0",
    "ms": "npm:ms@2.1.3",
    "framer-motion": "https://esm.sh/framer-motion@10.16.4?external=react,react-dom",
    "https://deno.land/x/emoji@0.3.0/": "https://deno.land/x/emoji@0.3.1/"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["dom", "esnext"]
  },
  "nodeModulesDir": "auto"
}
